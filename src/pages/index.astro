---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TimingStrip from '../components/TimingStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profile from '../data/profile.json';
import { getProjects } from '../data/projects';
import { Image } from 'astro:assets';
import teamPhoto from '../assets/team-silverstone-2026.jpg';

const projects = await getProjects();
const tel = profile.phone?.replace(/\s/g, '');
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="label">{profile.fullName} <span aria-hidden="true">·</span> {profile.location}</p>
    <h1 id="hero-title">{profile.name}</h1>
    <p class="hero__line">{profile.headline}</p>
    <p class="hero__intro">{profile.intro}</p>
    <p class="hero__status"><span class="hero__dot" aria-hidden="true"></span>{profile.availability}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={profile.cv} download><Icon name="download" /> Download CV</a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="me noopener"><Icon name="brand-linkedin" /> LinkedIn</a>
      <a class="btn" href={`mailto:${profile.email}`}><Icon name="mail" /> Email</a>
    </div>
    <div class="hero__timing">
      <TimingStrip cells={profile.timing} />
    </div>
  </section>

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="work-title">Work</h2>
        <p class="label">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
      </div>
      <div class="grid">
        {projects.map((p, i) => <ProjectCard project={p} eager={i < 2} />)}
      </div>
    </div>
  </section>

  <section id="skills" class="section" aria-labelledby="skills-title">
    <div class="wrap split">
      <div>
        <h2 id="skills-title">Skills</h2>
        <p class="side-lead">What I use, and where I've used it.</p>
      </div>
      <div class="about">
        <div class="block">
          <h3 class="label">Technical</h3>
          <div class="tech">
            {profile.skills.map((g) => (
              <div class="tech__group">
                <p class="mono tech__name">{g.group}</p>
                <ul>
                  {g.items.map((it) => <li><span>{it.name}</span>{it.detail && <span class="tech__detail">{it.detail}</span>}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
        <div class="block">
          <h3 class="label">Other roles</h3>
          <ul class="strengths">
            {profile.strengths.map((st) => <li><p class="strengths__title">{st.title}</p><p class="strengths__ev">{st.evidence}</p></li>)}
          </ul>
          <p class="mono langs">Languages · {profile.languages}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-title">
    <figure class="wrap team">
      <Image src={teamPhoto} alt="The UCD Formula Student team in green team shirts, cheering around car 135 and an Irish flag in front of the pit garages at Silverstone" widths={[800, 1400, 2200]} sizes="(max-width: 72rem) 100vw, 72rem" />
      <figcaption class="mono">UCD Formula Student at Formula Student UK, Silverstone, 2026</figcaption>
    </figure>
    <div class="wrap split">
      <div>
        <h2 id="about-title">About</h2>
        <div class="now">
          <p class="label">Right now · {profile.now.updated}</p>
          <ul>{profile.now.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <div class="about">
        <div class="about__text">
          {profile.about.map((para) => <p>{para}</p>)}
        </div>

        <div class="block">
          <h3 class="label">Experience</h3>
          <ul class="rows">
            {profile.experience.map((e) => (
              <li><span class="rows__main">{e.role}</span><span class="rows__sub">{e.org}</span><span class="rows__end mono">{e.dates}</span></li>
            ))}
          </ul>
        </div>

        <div class="block">
          <h3 class="label">Education</h3>
          <ul class="rows">
            <li><span class="rows__main">{profile.education.course}</span><span class="rows__sub">{profile.education.school} · {profile.education.detail}</span><span class="rows__end mono">{profile.education.dates}</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="wrap split">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p class="contact__lead">Email is the best way to get me. I'm always happy to talk about Formula Student, motorsport or bikes.</p>
      </div>
      <ul class="contact">
        <li>
          <Icon name="mail" /><span class="label">Email</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="contact__copy btn" type="button" data-copy={profile.email} aria-label="Copy email address">
            <Icon name="copy" /><span class="sr-only" aria-live="polite"></span>
          </button>
        </li>
        {tel && <li><Icon name="phone" /><span class="label">Phone</span><a href={`tel:${tel}`}>{profile.phone}</a></li>}
        <li><Icon name="brand-linkedin" /><span class="label">LinkedIn</span><a href={profile.linkedin} target="_blank" rel="me noopener">grzegorz-gornik</a></li>
        <li><Icon name="download" /><span class="label">CV</span><a href={profile.cv} download>Grzegorz_Gornik_CV.pdf</a></li>
        <li><Icon name="map-pin" /><span class="label">Based in</span><span>{profile.location}</span></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Copy email: the button turns green for 1.5s so you know it worked.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.classList.add('is-copied');
        btn.querySelector('.sr-only')!.textContent = 'Copied';
        setTimeout(() => { btn.classList.remove('is-copied'); btn.querySelector('.sr-only')!.textContent = ''; }, 1500);
      } catch { window.location.href = `mailto:${btn.dataset.copy}`; }
    });
  });
</script>

<style>
  .hero { padding-block: var(--s9) var(--s9); }
  h1 {
    font-size: clamp(3.5rem, 12vw, 9.5rem); font-stretch: 125%; font-weight: 800;
    letter-spacing: -0.035em; line-height: 0.9; margin: var(--s5) 0 var(--s6);
  }
  .hero__line { font-size: clamp(1.25rem, 2.2vw, 1.625rem); line-height: 1.35; font-stretch: 105%; max-width: 38rem; margin-bottom: var(--s5); }
  .hero__intro { color: var(--muted); max-width: 38rem; margin-bottom: var(--s6); }
  .hero__status { display: flex; align-items: center; gap: var(--s3); font-family: var(--mono); font-size: 0.8125rem; margin-bottom: var(--s6); }
  .hero__dot { width: var(--s2); height: var(--s2); background: var(--accent); border-radius: var(--radius); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s3); }
  .hero__timing { margin-top: var(--s9); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr)); gap: var(--s8) var(--s6); }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--s6); }
  @media (max-width: 52rem) { .split { grid-template-columns: 1fr; gap: var(--s6); } }

  .about { display: grid; gap: var(--s8); }
  .about__text { display: grid; gap: var(--s4); max-width: 40rem; font-size: 1.125rem; }
  .about__text p:not(:first-child) { color: var(--muted); }
  .about__text p:first-child { font-size: 1.25rem; line-height: 1.5; color: var(--text); }
  .block h3 { margin-bottom: var(--s4); font-weight: 400; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) 8.5rem; gap: var(--s4); align-items: baseline; padding-block: var(--s4); border-bottom: 1px solid var(--line); }
  .rows__main { font-weight: 500; }
  .rows__sub { color: var(--muted); }
  .rows__end { color: var(--muted); text-align: right; white-space: nowrap; }
  @media (max-width: 40rem) {
    .rows li { grid-template-columns: 1fr auto; gap: var(--s1) var(--s4); }
    .rows__sub { grid-row: 2; }
  }

  .contact__lead { color: var(--muted); margin-top: var(--s5); max-width: 22rem; }
  .contact { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .contact li { display: grid; grid-template-columns: auto 6rem 1fr auto; align-items: center; gap: var(--s4); min-height: var(--s8); padding-block: var(--s3); border-bottom: 1px solid var(--line); font-size: 1.125rem; }
  .contact li > :global(.icon) { color: var(--muted); }
  .contact a { text-decoration: none; overflow-wrap: anywhere; }
  .contact a:hover { color: var(--accent); }
  .contact__copy { padding: var(--s2); }
  .contact__copy.is-copied { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 40rem) { .contact li { grid-template-columns: auto 1fr auto; } .contact .label { display: none; } .contact li { font-size: 1rem; min-height: var(--s8); } }
  .team { margin: 0 auto var(--s8); }
  .team :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 45%; border-radius: var(--radius); border: 1px solid var(--line); }
  .team figcaption { color: var(--muted); margin-top: var(--s3); }
  .now { margin-top: var(--s7); max-width: 22rem; }
  .now ul { list-style: none; margin: var(--s4) 0 0; padding: 0; border-left: 1px solid var(--line); }
  .now li { padding: var(--s2) 0 var(--s2) var(--s4); color: var(--muted); font-size: 0.9375rem; line-height: 1.5; position: relative; }
  .now li::before { content: ''; position: absolute; left: -1px; top: var(--s3); width: 1px; height: var(--s4); background: var(--accent); }
  @media (max-width: 52rem) { .now { margin-top: var(--s5); } }
  .side-lead { color: var(--muted); margin-top: var(--s5); max-width: 22rem; }
  .tech { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--s6) var(--s6); }
  .tech__name { color: var(--accent); margin-bottom: var(--s3); }
  .tech ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .tech li { display: grid; gap: var(--s1); padding-block: var(--s3); border-bottom: 1px solid var(--line); }
  .tech__detail { font-size: 0.875rem; color: var(--muted); line-height: 1.45; }
  .strengths { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--s4); }
  .strengths li { padding: var(--s5); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); display: grid; gap: var(--s2); align-content: start; }
  .strengths__title { font-weight: 600; font-stretch: 108%; }
  .strengths__ev { color: var(--muted); font-size: 0.9375rem; line-height: 1.55; }
  .langs { color: var(--muted); margin-top: var(--s5); }
</style>

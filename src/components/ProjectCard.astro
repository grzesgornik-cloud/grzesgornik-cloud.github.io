---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StageBar from './StageBar.astro';
import Icon from './Icon.astro';
import { img } from '../data/images';
interface Props { project: CollectionEntry<'projects'>; eager?: boolean }
const { project, eager = false } = Astro.props;
const p = project.data;
---
<article class="card">
  <a class="card__link" href={`/projects/${project.id}/`}>
    <div class="card__media" style={`view-transition-name: cover-${project.id}`}>
      {p.cover
        ? <Image src={img(p.cover)} alt={p.coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 48rem) 100vw, 50vw" loading={eager ? 'eager' : 'lazy'} />
        : <div class="card__nophoto label">Photos to come</div>}
      {p.draft && <span class="card__draft label">Draft · preview only</span>}
    </div>
    <div class="card__body">
      <p class="label">{p.team} · {p.year}</p>
      <h3>{p.title} <Icon name="arrow-up-right" /></h3>
      <p class="card__summary">{p.summary}</p>
      <StageBar stage={p.stage} compact />
    </div>
  </a>
</article>

<style>
  .card__link { display: grid; gap: var(--s5); text-decoration: none; }
  .card__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .card__nophoto { display: grid; place-items: center; height: 100%; }
  .card__draft { position: absolute; top: var(--s3); left: var(--s3); padding: var(--s1) var(--s2); background: var(--bg); border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--text); }
  .card__body { display: grid; gap: var(--s3); }
  h3 { display: flex; align-items: center; gap: var(--s2); font-size: 1.5rem; }
  h3 :global(.icon) { color: var(--muted); transition: transform 0.2s var(--ease), color 0.2s var(--ease); }
  .card__link:hover h3 :global(.icon) { color: var(--accent); transform: translate(2px, -2px); }
  .card__summary { color: var(--muted); max-width: 34rem; margin-bottom: var(--s2); }
</style>
